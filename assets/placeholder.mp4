(function () {
  const app = window.TikTokApp || {};
  const state = window.appState;

  const dom = {
    settingsContent: document.getElementById('settingsContent')
  };

  function getNotificationRows() {
    return [
      { key: 'likes', label: 'Curtidas', description: 'Receba avisos sobre novos likes' },
      { key: 'comments', label: 'Comentários', description: 'Notificações de respostas e comentários' },
      { key: 'follows', label: 'Seguidores', description: 'Novos seguidores e menções' },
      { key: 'messages', label: 'Mensagens', description: 'Alertas de mensagens diretas' }
    ];
  }

  function render() {
    const userOptions = state.users.map((user) => `
      <option value="${user.id}" ${user.id === state.currentUserId ? 'selected' : ''}>${user.username}</option>
    `).join('');

    dom.settingsContent.innerHTML = `
      <div class="settings-card">
        <div class="setting-row">
          <div class="setting-copy">
            <strong>Tema</strong>
            <span>Modo claro ou escuro</span>
          </div>
          <button id="themeToggle" class="switch ${state.theme === 'light' ? 'on' : ''}" aria-label="Alternar tema" aria-checked="${state.theme === 'light'}"></button>
        </div>

        ${getNotificationRows().map((item) => `
          <div class="setting-row">
            <div class="setting-copy">
              <strong>${item.label}</strong>
              <span>${item.description}</span>
            </div>
            <button class="switch ${state.notifications[item.key] ? 'on' : ''}" data-setting-toggle="${item.key}" aria-label="Alternar ${item.label}" aria-checked="${state.notifications[item.key]}" role="switch"></button>
          </div>
        `).join('')}

        <div class="setting-row" style="display: block; border-bottom: none; padding-bottom: 0;">
          <div class="setting-copy">
            <strong>Trocar de usuário</strong>
            <span>Selecione um perfil para testar publicações</span>
          </div>
          <div class="user-switcher">
            <select id="userSelector">
              ${userOptions}
            </select>
          </div>
        </div>

        <button id="logoutBtn" class="logout-btn">Sair / Logout</button>
      </div>
    `;

    const themeToggle = document.getElementById('themeToggle');
    themeToggle.addEventListener('click', () => {
      const nextTheme = state.theme === 'dark' ? 'light' : 'dark';
      app.applyTheme(nextTheme);
      render();
    });

    document.querySelectorAll('[data-setting-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const key = toggle.dataset.settingToggle;
        state.notifications[key] = !state.notifications[key];
        render();
      });
    });

    document.getElementById('userSelector').addEventListener('change', (event) => {
      state.currentUserId = event.target.value;
      app.profile.render();
      app.feed.render();
      app.search.render();
      render();
    });

    document.getElementById('logoutBtn').addEventListener('click', () => {
      app.setActiveTab('feedTab');
      state.currentUserId = 'u_1';
      app.profile.render();
      app.feed.render();
      app.search.render();
      render();
    });
  }

  function init() {
    render();
  }

  app.settings = app.settings || {};
  app.settings.init = init;
  app.settings.render = render;
})(window);
